# ---------- сервер ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- ИИ-модель (OpenAI-совместимый API) ----------
# Провайдер: openai | openrouter | groq | deepseek | inception | ollama | custom
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Для custom/ollama укажите свой адрес, для остальных подставляется автоматически
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_CHUNK_CHARS=12000

# Примеры дешёвых замен:
#   LLM_PROVIDER=groq        LLM_MODEL=llama-3.1-8b-instant
#   LLM_PROVIDER=deepseek    LLM_MODEL=deepseek-chat
#   LLM_PROVIDER=openrouter  LLM_MODEL=google/gemini-flash-1.5
#   LLM_PROVIDER=inception   LLM_MODEL=mercury-2.5   (очень дёшево, контекст 260k)
#   LLM_PROVIDER=ollama      LLM_MODEL=qwen2.5:3b   (полностью локально, ключ не нужен)
#   LLM_PROVIDER=custom      LLM_BASE_URL=<адрес>  (любой свой OpenAI-совместимый сервер)

# ---------- транскрибация ----------
# Сначала пробуем готовые субтитры YouTube (бесплатно), потом движок ниже
PREFER_YOUTUBE_SUBTITLES=true
# faster_whisper (локально, CPU) | openai (Whisper API, ~$0.006/мин)
TRANSCRIBER=faster_whisper
WHISPER_MODEL=base          # tiny | base | small — для слабого ПК tiny/base
WHISPER_COMPUTE_TYPE=int8
# WHISPER_VAD=false
WHISPER_LANGUAGE=ru       # пусто = автоопределение
SUBTITLE_LANGS=ru,en

# ---------- ограничения ----------
MAX_VIDEO_MINUTES=120

# ---------- доступ и лимиты (важно для публичного запуска) ----------
# Токен для /api/*. Пусто = API открыт всем (локально и для публичного демо).
# Для публичного запуска задайте длинную случайную строку: openssl rand -hex 32
# Тогда все /api/* требуют заголовок Authorization: Bearer <токен>.
API_TOKEN=
# Включите, только если приложение закрыто своим прокси (Caddy/nginx): тогда IP клиента
# берётся из X-Forwarded-For. Напрямую в интернет не выставляйте — заголовок подделывается.
TRUST_PROXY=false
# Лимиты на дорогие запросы (транскрибация + LLM) и на чтение статуса.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PROCESS_PER_MINUTE=10
RATE_LIMIT_PROCESS_PER_DAY=50
RATE_LIMIT_READ_PER_MINUTE=120
MAX_CONCURRENT_JOBS_PER_CLIENT=2

# ---------- обход блокировки YouTube на хостинге ----------
# Если видите "Sign in to confirm you're not a bot": экспортируйте cookies.txt из браузера
# (расширение "Get cookies.txt LOCALLY") и укажите путь, либо задайте прокси
# YT_COOKIES_FILE=./data/cookies.txt
# YT_PROXY=socks5://user:pass@host:1080
